{
  "name": "crossfitleek",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "format:changed": "prettier $(git ls-files --modified --others --exclude-standard) --write",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0 --report-unused-disable-directives",
    "lint:changed": "eslint $(git ls-files --modified --others --exclude-standard) --max-warnings 0 --report-unused-disable-directives",
    "typecheck": "pnpm tsc --noEmit"
  },
  "dependencies": {
    "cn": "^0.4.0",
    "cva": "1.0.0-beta.12",
    "next": "16.3.5",
    "next-intl": "^4.14.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "latest",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
